{
  "id": "standard",
  "name": "标准",
  "name_en": "Standard",
  "description": "小四正文、层级标题、首行缩进，适合通用文档与内部材料",
  "description_en": "Small-four body with hierarchical headings and first-line indent for general documents",

  "body": {
    "fontSize": "12pt",
    "lineHeight": 1.5
  },

  "headings": {
    "h1": { "fontSize": "18pt", "spacingBefore": "0pt", "spacingAfter": "12pt", "alignment": "center" },
    "h2": { "fontSize": "16pt", "spacingBefore": "14pt", "spacingAfter": "8pt" },
    "h3": { "fontSize": "14pt", "spacingBefore": "12pt", "spacingAfter": "6pt" },
    "h4": { "fontSize": "12pt", "spacingBefore": "10pt", "spacingAfter": "6pt" },
    "h5": { "fontSize": "12pt", "spacingBefore": "8pt", "spacingAfter": "4pt" },
    "h6": { "fontSize": "12pt", "spacingBefore": "6pt", "spacingAfter": "4pt" }
  },

  "code": {
    "fontSize": "10.5pt"
  },

  "blocks": {
    "paragraph": { "spacingAfter": "0pt", "firstLineIndent": true },
    "list": { "spacingAfter": "4pt" },
    "listItem": { "spacingAfter": "2pt" },
    "blockquote": {
      "spacingBefore": "10pt",
      "spacingAfter": "10pt",
      "paddingVertical": "2pt",
      "paddingHorizontal": "14pt"
    },
    "codeBlock": { "spacingAfter": "10pt" },
    "table": { "spacingAfter": "8pt" },
    "horizontalRule": { "spacingBefore": "16pt", "spacingAfter": "16pt" }
  }
}
