{
  "id": "formal-paper",
  "name": "论文排版",
  "name_en": "Formal Paper",
  "description": "中文学术论文排版：宋体正文、黑体标题分层、1.5 倍行距、首行缩进",
  "description_en": "Chinese academic paper layout with Song body, Hei headings and 1.5 line spacing",
  
  "body": {
    "fontSize": "12pt",
    "lineHeight": 1.5
  },
  
  "headings": {
    "h1": { "fontSize": "16pt", "spacingBefore": "0pt", "spacingAfter": "14pt", "alignment": "center" },
    "h2": { "fontSize": "14pt", "spacingBefore": "14pt", "spacingAfter": "8pt" },
    "h3": { "fontSize": "12pt", "spacingBefore": "12pt", "spacingAfter": "6pt" },
    "h4": { "fontSize": "12pt", "spacingBefore": "10pt", "spacingAfter": "6pt" },
    "h5": { "fontSize": "12pt", "spacingBefore": "8pt", "spacingAfter": "4pt" },
    "h6": { "fontSize": "12pt", "spacingBefore": "6pt", "spacingAfter": "4pt" }
  },
  
  "code": {
    "fontSize": "10pt"
  },
  
  "blocks": {
    "paragraph": { "spacingAfter": "6pt", "firstLineIndent": true },
    "list": { "spacingAfter": "6pt" },
    "listItem": { "spacingAfter": "2pt" },
    "blockquote": {
      "spacingBefore": "10pt",
      "spacingAfter": "10pt",
      "paddingVertical": "2pt",
      "paddingHorizontal": "14pt"
    },
    "codeBlock": { "spacingAfter": "10pt" },
    "table": { "spacingAfter": "8pt", "fontSize": "10.5pt", "lineHeight": 1 },
    "horizontalRule": { "spacingBefore": "16pt", "spacingAfter": "16pt" }
  }
}
