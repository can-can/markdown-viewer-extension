{
  "id": "formal",
  "name": "正式文书",
  "name_en": "Formal",
  "description": "仿党政机关公文排版：仿宋正文、黑体/楷体标题、首行缩进、1.75 倍行距",
  "description_en": "Government-style official document layout with FangSong body, Hei/Kai headings and first-line indent",
  
  "body": {
    "fontSize": "16pt",
    "lineHeight": 1.75
  },
  
  "headings": {
    "h1": { "fontSize": "22pt", "spacingBefore": "0pt", "spacingAfter": "14pt", "alignment": "center" },
    "h2": { "fontSize": "16pt", "spacingBefore": "16pt", "spacingAfter": "8pt" },
    "h3": { "fontSize": "16pt", "spacingBefore": "14pt", "spacingAfter": "6pt" },
    "h4": { "fontSize": "16pt", "spacingBefore": "12pt", "spacingAfter": "6pt" },
    "h5": { "fontSize": "16pt", "spacingBefore": "10pt", "spacingAfter": "4pt" },
    "h6": { "fontSize": "16pt", "spacingBefore": "8pt", "spacingAfter": "4pt" }
  },
  
  "code": {
    "fontSize": "12pt"
  },
  
  "blocks": {
    "paragraph": { "spacingAfter": "0pt", "firstLineIndent": true },
    "list": { "spacingAfter": "4pt" },
    "listItem": { "spacingAfter": "2pt" },
    "blockquote": {
      "spacingBefore": "12pt",
      "spacingAfter": "12pt",
      "paddingVertical": "2pt",
      "paddingHorizontal": "14pt"
    },
    "codeBlock": { "spacingAfter": "12pt" },
    "table": { "spacingAfter": "8pt" },
    "horizontalRule": { "spacingBefore": "20pt", "spacingAfter": "20pt" }
  }
}
